APP_NAME=AI Editorial Desk
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

POSTGRES_USER=ai_editorial
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=ai_editorial
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://ai_editorial:replace-with-a-local-password@127.0.0.1:55432/ai_editorial

APP_SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
APP_ADMIN_TOKEN=replace-with-an-internal-admin-token-at-least-24-characters
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_READY_TIMEOUT_SECONDS=2

MEDIACRAWLER_HOME=third_party/MediaCrawler
MEDIACRAWLER_PYTHON=python
MEDIACRAWLER_TIMEOUT_SECONDS=900
# Local runtime-only root. Keep browser profiles out of Git; .runtime/ is ignored.
MEDIACRAWLER_PROFILE_ROOT=.runtime/mediacrawler_profiles

# Local dedicated browser runtime for human-operated platform login.
# In local development bound to 127.0.0.1 / localhost it is available automatically.
# Production / remote deployments stay disabled unless explicitly opted in; a future
# Local Runtime Agent should be used when the API runs on a different machine.
LOCAL_BROWSER_RUNTIME_ENABLED=false
# Optional absolute browser path. Leave empty to auto-detect Chrome / Edge.
LOCAL_BROWSER_RUNTIME_EXECUTABLE=
# Loopback-only CDP port used by the current MediaCrawler preflight/runtime contract.
LOCAL_BROWSER_RUNTIME_PORT=9222

# AI Provider secrets
#
# The admin UI stores only opaque references such as env://DEEPSEEK_API_KEY.
# Real secrets belong here for local development, or in OS / Docker / systemd /
# Kubernetes / cloud-secret injected environment variables in production.
# Process-level environment variables always take precedence over this .env fallback.
# The AI credential resolver parses this file privately and does not export these values
# into os.environ, so child processes do not receive provider secrets just because .env exists.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=

# Optional aliases for generic route/provider deployments.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
LOW_COST_LLM_BASE_URL=
LOW_COST_LLM_API_KEY=
STRONG_LLM_BASE_URL=
STRONG_LLM_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional: point the AI credential resolver at a dedicated env file.
# Cloud / OS process environment values still have higher priority.
# AI_EDITORIAL_ENV_FILE=/etc/ai-editorial-desk/provider-secrets.env
