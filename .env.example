APP_NAME=AI Editorial Desk
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

POSTGRES_USER=ai_editorial
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=ai_editorial
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://ai_editorial:replace-with-a-local-password@127.0.0.1:55432/ai_editorial

APP_SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_READY_TIMEOUT_SECONDS=2

MEDIACRAWLER_HOME=third_party/MediaCrawler
MEDIACRAWLER_PYTHON=python
MEDIACRAWLER_TIMEOUT_SECONDS=900

# AI providers are configured in the application later; never commit real keys.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
LOW_COST_LLM_BASE_URL=
LOW_COST_LLM_API_KEY=
STRONG_LLM_BASE_URL=
STRONG_LLM_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
